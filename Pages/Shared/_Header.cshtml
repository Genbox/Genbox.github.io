<header class="site-header container">
    <div class="site-brand">
        <a class="wordmark" href="/">
            <span aria-hidden="true" class="wordmark-icon">&gt;_</span>
            <span class="wordmark-text"><strong>@SiteCatalog.Title</strong><span>by @SiteCatalog.Author</span></span>
        </a>
    </div>
    <nav aria-label="Main navigation" class="site-nav">
        <a href="/" aria-current="@(Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/page") ? "page" : null)">Articles</a>
        <a href="/projects/" aria-current="@(Context.Request.Path == "/projects/" ? "page" : null)">Projects</a>
        <a href="/friends/" aria-current="@(Context.Request.Path == "/friends/" ? "page" : null)">Friends</a>
        <a href="/about/" aria-current="@(Context.Request.Path == "/about/" ? "page" : null)">About</a>
        <a href="/feed.xml" rel="noopener" target="_blank">RSS <span aria-hidden="true">↗</span></a>
        <a aria-keyshortcuts="Control+K /" aria-label="Search articles" class="icon-link" data-index="/search.json" href="/search/" title="Search (Ctrl+K)" aria-current="@(Context.Request.Path == "/search/" ? "page" : null)">
            <svg aria-hidden="true" fill="none" height="17" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24" width="17">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
            </svg>
        </a>
        <a aria-label="@SiteCatalog.Author on GitHub" class="icon-link" href="@SiteCatalog.AuthorUrl" rel="noopener" target="_blank" title="GitHub">
            <svg aria-hidden="true" fill="currentColor" height="18" viewBox="0 0 16 16" width="18">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
        </a>
    </nav>
</header>