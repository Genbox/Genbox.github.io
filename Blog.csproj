<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AspNetStatic" Version="0.27.8"/>
        <PackageReference Include="ColorCode.HTML" Version="2.0.15"/>
        <PackageReference Include="Markdig" Version="1.5.1"/>
        <PackageReference Include="YamlDotNet" Version="18.1.0"/>
        <PackageReference Include="AngleSharp" Version="1.9.1"/>
        <PackageReference Include="NUglify" Version="1.23.4"/>
        <PackageReference Include="PeachDrawing" Version="0.9.25"/>
        <PackageReference Include="PeachImage" Version="0.6.2"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="_posts/**/*.md;assets/**/*" CopyToPublishDirectory="PreserveNewest"/>
        <Content Update="_data/**/*.json" CopyToPublishDirectory="PreserveNewest"/>
        <Content Remove="_drafts/**/*"/>
        <None Remove="_drafts/**/*"/>
    </ItemGroup>
</Project>